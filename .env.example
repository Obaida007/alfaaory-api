APP_NAME="متجر الفاعوري"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Asia/Damascus

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# mysql أو pgsql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alfaore
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- متجر الفاعوري ----
# نطاق/نطاقات الواجهة المسموح لها (CORS)، مفصولة بفواصل
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS="${FRONTEND_URL},https://alfaore-store.com,https://www.alfaore-store.com"

# حساب super_admin الذي ينشئه الـ seeder (مطلوب لـ db:seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# تسجيل الدخول عبر Google (معرّف عميل OAuth للتحقق من id_token)
GOOGLE_CLIENT_ID=

# ربط تيليجرام
TELEGRAM_BOT_USERNAME=

# مزوّد شحن الألعاب: fake للتطوير
GAME_PROVIDER=fake

# حدود الطلبات في الدقيقة
RATE_LIMIT_LOGIN=5
RATE_LIMIT_CHECK_NAME=20
RATE_LIMIT_ORDERS=10

# اجعل /docs/api متاحًا للجميع في الإنتاج (وإلا فللمشرفين فقط)
API_DOCS_PUBLIC=false
